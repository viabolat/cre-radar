# Harvested per-lead evidence (screenshots, deed PDFs) — can be large, not for the repo
data/evidence/*
!data/evidence/.gitkeep
!data/evidence/_permits/
# ...but keep the shared source permit reports (small, cited by every signal row)
!data/evidence/_permits/**
# ...and the shared registry / SOC diligence workbook (small, cited by every registry + entity row)
!data/evidence/_registry/
!data/evidence/_registry/**

# The CSVs are this repo's payload — override the global *.csv ignore
!data/leads.csv
!data/signals.csv
!data/entities.csv
!outreach/tracker.csv

# OS / editor cruft
.DS_Store
*.swp

# Independently git-cloned tool repos living inside this working tree —
# never track these as gitlinks from cre_radar's own history.
/massrecords-api/
/cre_sop/
